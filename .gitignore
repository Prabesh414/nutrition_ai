# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
*.egg-info/
.coverage
htmlcov/

# Environment Variables -- never commit real credentials
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Database dumps. These contain real user emails and password hashes.
backups/
*.dump
*.sql.gz

# Local databases
*.db
*.sqlite3

# Trained model artefacts (regenerated deterministically on first run)
backend/ml/lstm_weights.pth

# Editor & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# NOTE: food_dataset/ is intentionally tracked. The application cannot run
# without it, so excluding it made a fresh clone unusable.

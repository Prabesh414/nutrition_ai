# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Leave DATABASE_URL unset to use a local SQLite file (zero-setup development).
# For PostgreSQL:
#   DATABASE_URL=postgresql://user:password@host:5432/nutrition_ai
DATABASE_URL=

# Required when ENVIRONMENT=production; a random per-process key is used in
# development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# development | production
ENVIRONMENT=development

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nutrition coach (Gemini). All optional: with no key the coach falls back to
# deterministic rule-based replies and the app still runs.
#
# Keys are tried in order. Every key is attempted on the first model before
# the chain drops to the next, so quality degrades only when it must.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=

# Preference order, strongest first. Verify these ids against Google's
# current model list -- names and free-tier availability change.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20

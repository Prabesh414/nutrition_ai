# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Leave DATABASE_URL unset to use a local SQLite file (zero-setup development).
# For PostgreSQL:
#   DATABASE_URL=postgresql://user:password@host:5432/nutrition_ai
DATABASE_URL=

# Required when ENVIRONMENT=production; a random per-process key is used in
# development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# development | production
ENVIRONMENT=development

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nutrition coach. If Ollama is not running the coach falls back to
# deterministic rule-based replies, so these are optional.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

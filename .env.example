# Single configuration file for the WHOLE app -- backend and frontend.
# Copy to .env (repository root) and fill in. NEVER commit the real .env.
#
# The backend reads this via backend/config.py. The Vite frontend reads the
# same file (frontend/vite.config.ts sets envDir to the root), but Vite only
# exposes variables prefixed with VITE_ to the browser. Everything else here
# -- database URL, JWT secret, Gemini keys -- stays server-side.
# ---------------------------------------------------------------------------

# ===== Backend ==============================================================

# Leave DATABASE_URL unset to use a local SQLite file (zero-setup development).
# For PostgreSQL:
#   DATABASE_URL=postgresql://user:password@host:5432/nutrition_ai
DATABASE_URL=

# Required when ENVIRONMENT=production; a random per-process key is used in
# development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# development | production
ENVIRONMENT=development

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Nutrition coach (Gemini) =============================================
# All optional: with no key the coach falls back to deterministic rule-based
# replies and the app still runs.
#
# Keys are tried in order (GEMINI_API_KEY1 .. GEMINI_API_KEY8). Every key is
# attempted on the first model before the chain drops to the next model, so
# quality degrades only when it must. A rate-limited key is benched briefly;
# a model that 404s is retired for the process.
GEMINI_API_KEY1=
GEMINI_API_KEY2=

# Model fallback order, strongest first. These are free-tier friendly; verify
# the ids against Google's current model list -- names and quotas change.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_TOTAL_BUDGET_SECONDS=12

# ===== Frontend (exposed to the browser -- never put secrets here) ==========
VITE_API_URL=http://localhost:8000/api/v1
